import {
    Button,
    ScrollView,
    LineEdit,
    ComboBox,
    Palette,
    ProgressIndicator,
} from "std-widgets.slint";
import { Channel } from "common.slint";

export enum RotateAngle { R90, R180, R270, Random }
export enum FlipDirection { Horizontal, Vertical }

export enum PipelineStepKind {
    Rotate, GaussianBlur, Brighten, Resize, ExtractChannel, Flip,
    Contrast, Saturation, Crop, Grayscale, Noise, Sharpness,
}

export struct PipelineStep {
    kind: PipelineStepKind,
    rotate-angle: RotateAngle,
    blur-sigma: float,
    brighten-value: int,
    resize-width: int,
    resize-height: int,
    flip-direction: FlipDirection,
    extract-channel: Channel,
    contrast-value: float,
    saturation-value: float,
    crop-x: int,
    crop-y: int,
    crop-width: int,
    crop-height: int,
    noise-intensity: float,
    sharpness-amount: float,
}

global StepKind {
    pure public function name(kind: PipelineStepKind) -> string {
        kind == PipelineStepKind.Rotate ? "Rotate" : kind == PipelineStepKind.GaussianBlur ? "Gaussian Blur" : kind == PipelineStepKind.Brighten ? "Brighten" : kind == PipelineStepKind.Resize ? "Resize" : kind == PipelineStepKind.Flip ? "Flip" : kind == PipelineStepKind.ExtractChannel ? "Extract Channel" : kind == PipelineStepKind.Contrast ? "Contrast" : kind == PipelineStepKind.Saturation ? "Saturation" : kind == PipelineStepKind.Crop ? "Crop" : kind == PipelineStepKind.Grayscale ? "Grayscale" : kind == PipelineStepKind.Noise ? "Noise" : "Sharpness"
    }

    pure public function from-name(n: string) -> PipelineStepKind {
        n == "Rotate" ? PipelineStepKind.Rotate : n == "Gaussian Blur" ? PipelineStepKind.GaussianBlur : n == "Brighten" ? PipelineStepKind.Brighten : n == "Resize" ? PipelineStepKind.Resize : n == "Flip" ? PipelineStepKind.Flip : n == "Extract Channel" ? PipelineStepKind.ExtractChannel : n == "Contrast" ? PipelineStepKind.Contrast : n == "Saturation" ? PipelineStepKind.Saturation : n == "Crop" ? PipelineStepKind.Crop : n == "Grayscale" ? PipelineStepKind.Grayscale : n == "Noise" ? PipelineStepKind.Noise : PipelineStepKind.Sharpness
    }
}

component ParamRow inherits HorizontalLayout {
    in property <string> label;
    in property <length> label-width: 48px;
    spacing: 6px;

    Text {
        text: root.label;
        font-size: 12px;
        vertical-alignment: center;
        width: root.label-width;
    }

    @children
}

component StepWrapper inherits Rectangle {
    in-out property <PipelineStep> step;
    callback move-up();
    callback move-down();
    callback remove();
    callback changed(PipelineStep);

    height: 76px;
    border-color: Palette.border;
    border-radius: 6px;
    border-width: 1px;

    property <length> input-w: 72px;
    property <length> crop-w: 52px;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        HorizontalLayout {
            height: 25px;
            spacing: 6px;

            Text {
                text: StepKind.name(step.kind);
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Button {
                icon: @image-url("icons/keyboard-arrow-up.svg");
                colorize-icon: true;
                clicked => root.move-up();
            }

            Button {
                icon: @image-url("icons/keyboard-arrow-down.svg");
                colorize-icon: true;
                clicked => root.move-down();
            }

            Button {
                icon: @image-url("icons/clear.svg");
                colorize-icon: true;
                clicked => root.remove();
            }
        }

        if step.kind == PipelineStepKind.Rotate: ParamRow {
            label: "Angle";
            ComboBox {
                model: ["90°", "180°", "270°", "Random"];
                current-index: step.rotate-angle == RotateAngle.R90 ? 0 : step.rotate-angle == RotateAngle.R180 ? 1 : step.rotate-angle == RotateAngle.R270 ? 2 : 3;
                selected(val) => {
                    step.rotate-angle = val == "90°" ? RotateAngle.R90 : val == "180°" ? RotateAngle.R180 : val == "270°" ? RotateAngle.R270 : RotateAngle.Random;
                    root.changed(step);
                }
            }
        }

        if step.kind == PipelineStepKind.GaussianBlur: ParamRow {
            label: "Sigma:";
            LineEdit {
                width: root.input-w * 2;
                text: step.blur-sigma;
                input-type: number;
                placeholder-text: "1.0";
                edited(val) => {
                    let f = val.to-float();
                    if (f > 0.0) {
                        step.blur-sigma = f;
                        root.changed(step);
                    }
                }
            }

            Text {
                text: "px";
                font-size: 10px;
                vertical-alignment: center;
            }
        }

        if step.kind == PipelineStepKind.Brighten: ParamRow {
            label: "Value:";
            LineEdit {
                width: root.input-w * 2;
                text: step.brighten-value;
                input-type: number;
                placeholder-text: "10";
                edited(val) => {
                    step.brighten-value = val.to-float();
                    root.changed(step);
                }
            }

            Text {
                text: "(-255..255)";
                font-size: 9px;
                vertical-alignment: center;
            }
        }

        if step.kind == PipelineStepKind.Resize: ParamRow {
            label: "W:";
            label-width: 18px;
            LineEdit {
                width: root.input-w;
                text: step.resize-width;
                input-type: number;
                edited(val) => {
                    step.resize-width = Math.max(1, val.to-float());
                    root.changed(step);
                }
            }

            Text {
                text: "H:";
                font-size: 12px;
                vertical-alignment: center;
            }

            LineEdit {
                width: root.input-w;
                text: step.resize-height;
                input-type: number;
                edited(val) => {
                    step.resize-height = Math.max(1, val.to-float());
                    root.changed(step);
                }
            }
        }

        if step.kind == PipelineStepKind.Flip: ParamRow {
            label: "Dir:";
            label-width: 30px;
            ComboBox {
                model: ["Horizontal", "Vertical"];
                current-index: step.flip-direction == FlipDirection.Horizontal ? 0 : 1;
                selected(val) => {
                    step.flip-direction = val == "Horizontal" ? FlipDirection.Horizontal : FlipDirection.Vertical;
                    root.changed(step);
                }
            }
        }

        if step.kind == PipelineStepKind.ExtractChannel: ParamRow {
            label: "Chan:";
            label-width: 40px;
            ComboBox {
                model: ["Gray", "Red", "Green", "Blue", "Hue", "Saturation", "Value"];
                current-index: step.extract-channel == Channel.Gray ? 0 : step.extract-channel == Channel.Red ? 1 : step.extract-channel == Channel.Green ? 2 : step.extract-channel == Channel.Blue ? 3 : step.extract-channel == Channel.Hue ? 4 : step.extract-channel == Channel.Saturation ? 5 : 6;
                selected(val) => {
                    step.extract-channel = val == "Gray" ? Channel.Gray : val == "Red" ? Channel.Red : val == "Green" ? Channel.Green : val == "Blue" ? Channel.Blue : val == "Hue" ? Channel.Hue : val == "Saturation" ? Channel.Saturation : Channel.Value;
                    root.changed(step);
                }
            }
        }

        if step.kind == PipelineStepKind.Contrast: ParamRow {
            label: "Value:";
            LineEdit {
                width: root.input-w;
                text: step.contrast-value;
                input-type: number;
                placeholder-text: "1.0";
                edited(val) => {
                    step.contrast-value = val.to-float();
                    root.changed(step);
                }
            }
        }

        if step.kind == PipelineStepKind.Saturation: ParamRow {
            label: "Factor:";
            LineEdit {
                width: root.input-w * 2;
                text: step.saturation-value;
                input-type: number;
                placeholder-text: "1.0";
                edited(val) => {
                    step.saturation-value = val.to-float();
                    root.changed(step);
                }
            }
        }

        if step.kind == PipelineStepKind.Crop: HorizontalLayout {
            spacing: 4px;
            Text {
                text: "X:";
                font-size: 11px;
                vertical-alignment: center;
                width: 14px;
            }

            LineEdit {
                width: root.crop-w;
                text: step.crop-x;
                input-type: number;
                edited(val) => {
                    step.crop-x = Math.max(0, val.to-float());
                    root.changed(step);
                }
            }

            Text {
                text: "Y:";
                font-size: 11px;
                vertical-alignment: center;
                width: 14px;
            }

            LineEdit {
                width: root.crop-w;
                text: step.crop-y;
                input-type: number;
                edited(val) => {
                    step.crop-y = Math.max(0, val.to-float());
                    root.changed(step);
                }
            }

            Text {
                text: "W:";
                font-size: 11px;
                vertical-alignment: center;
                width: 14px;
            }

            LineEdit {
                width: root.crop-w;
                text: step.crop-width;
                input-type: number;
                edited(val) => {
                    step.crop-width = Math.max(1, val.to-float());
                    root.changed(step);
                }
            }

            Text {
                text: "H:";
                font-size: 11px;
                vertical-alignment: center;
                width: 14px;
            }

            LineEdit {
                width: root.crop-w;
                text: step.crop-height;
                input-type: number;
                edited(val) => {
                    step.crop-height = Math.max(1, val.to-float());
                    root.changed(step);
                }
            }
        }

        if step.kind == PipelineStepKind.Noise: ParamRow {
            label: "Intens:";
            LineEdit {
                width: root.input-w * 2;
                text: step.noise-intensity;
                input-type: number;
                placeholder-text: "0.1";
                edited(val) => {
                    step.noise-intensity = val.to-float().clamp(0.0, 1.0);
                    root.changed(step);
                }
            }

            Text {
                text: "(0..1)";
                font-size: 9px;
                vertical-alignment: center;
            }
        }

        if step.kind == PipelineStepKind.Sharpness: ParamRow {
            label: "Amount:";
            label-width: 52px;
            LineEdit {
                width: root.input-w * 2;
                text: step.sharpness-amount;
                input-type: number;
                placeholder-text: "1.0";
                edited(val) => {
                    step.sharpness-amount = Math.max(0.0, val.to-float());
                    root.changed(step);
                }
            }
        }
    }
}

component AddStepMenu inherits Rectangle {
    callback add-step(PipelineStepKind);
    height: 28px;

    ComboBox {
        model: [
            "Add step",
            "Rotate",
            "Gaussian Blur",
            "Brighten",
            "Resize",
            "Extract Channel",
            "Flip",
            "Contrast",
            "Saturation",
            "Crop",
            "Grayscale",
            "Noise",
            "Sharpness",
        ];
        selected(val) => {
            if (val != "Add step") {
                root.add-step(StepKind.from-name(val));
            }
            self.current-index = 0;
        }
    }
}

export component PipelinePanel inherits Rectangle {
    in-out property <[PipelineStep]> steps;
    in property <float> progress;
    in property <[string]> encoder_extensions;
    callback request-add-step(PipelineStepKind);
    callback request-remove-step(int);
    callback request-move-step(int, int);
    callback request-update-step(int, PipelineStep);
    callback run-pipeline(string);

    changed progress => {
        debug(progress);
        if abs(progress - 1.0) < 0.01 {
            save-btn.enabled = true;
        } else if (progress > 0) {
            save-btn.enabled = false;
        }
    }

    HorizontalLayout {
        padding: 6px;
        VerticalLayout {
            spacing: 6px;

            VerticalLayout {
                Text {
                    text: "Pipeline";
                    font-size: 14px;
                    font-weight: 700;
                }

                AddStepMenu {
                    add-step(k) => {
                        root.request-add-step(k);
                    }
                }
            }

            ScrollView {
                viewport-height: steps.length * 76px;
                VerticalLayout {
                    for step[i] in root.steps: StepWrapper {
                        step: step;
                        move-up => root.request-move-step(i, i - 1);
                        move-down => root.request-move-step(i, i + 1);
                        remove => root.request-remove-step(i);
                        changed(s) => root.request-update-step(i, s);
                    }
                }
            }

            HorizontalLayout {
                save-btn := Button {
                    text: "Save";
                    height: 34px;
                    primary: true;
                    clicked => {
                        root.run-pipeline(extensions-combo-box.current-value);
                    }
                }

                extensions-combo-box := ComboBox {
                    model: encoder_extensions;
                }
            }

            HorizontalLayout {
                height: 30px;
                spacing: 3px;
                Text {
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    text: "Progress:";
                }

                ProgressIndicator {
                    indeterminate: false;
                    progress <=> root.progress;
                }
            }
        }
    }
}
